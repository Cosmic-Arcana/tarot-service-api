NODE_ENV=development
LOG_LEVEL=log

HTTP_PORT=3004

DATABASE_URL=postgres://tarot:tarot@localhost:5433/tarot
DATABASE_RUN_MIGRATIONS=true

# stub keeps the draw local and deterministic; ai-service calls ai-service-api over tcp
SPREAD_GENERATOR=stub
AI_SERVICE_TCP_HOST=127.0.0.1
AI_SERVICE_TCP_PORT=4001
AI_SERVICE_TIMEOUT_MS=20000

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
EVENT_DELIVERY_ATTEMPTS=10
EVENT_DELIVERY_BACKOFF_MS=1000

# Native WebSocket on the HTTP port: path /live. Emits spread.drawn (card ids only, no question).

# Off by default so local e2e stays open. Production: true + INTERNAL_SERVICE_TOKEN.
# REQUIRE_SPREAD_AUTH=false
# INTERNAL_SERVICE_TOKEN=
